{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=insuranceapp_db;User=root;Password=qwerty123;"
  },
  "Jwt": {
    "Issuer": "InsuranceApp",
    "Audience": "InsuranceApp.MobileAndWeb",
    "Key": "change_this_to_a_long_random_secret_key_for_dev_only",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "Auth": {
    "RequireOtpOnLogin": true,
    "OtpForHighRiskDevicesOnly": true,
    "TrustedDeviceWindowDays": 90
  },
  "Otp": {
    "CodeLength": 6,
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "ThrottleSeconds": 60,
    "LockoutMinutes": 15,
    "MaxRequestsPerHour": 5
  },
  "Nia": {
    "UseMock": false,
    "BaseUrl": "https://sandbox.nia.gov.gh/api",
    "ApiKey": "REPLACE_WITH_NIA_API_KEY",
    "EnforceSignatureValidation": false,
    "SignatureHeaderName": "X-Signature",
    "SignatureSecret": "REPLACE_WITH_NIA_SIGNATURE_SECRET",
    "TimeoutSeconds": 10,
    "RetryCount": 3,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDurationSeconds": 60
  },
  "OtpProvider": {
    "BaseUrl": "https://sandbox.sms-provider.example/api",
    "ApiKey": "REPLACE_WITH_OTP_PROVIDER_API_KEY",
    "SenderId": "InsuranceApp",
    "EndpointPath": "/messages/otp",
    "UseLoggingFallback": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
