@model CreatePolicyViewModel
@{
    ViewData["Title"] = "Create Policy";
}

<h2>Create Policy From Quote</h2>
<p class="text-muted">Admin and agent users can issue policies directly from an approved quote reference.</p>

<form asp-action="Create" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="QuoteReference" class="form-label"></label>
            <input asp-for="QuoteReference" class="form-control" />
            <span asp-validation-for="QuoteReference" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CustomerId" class="form-label"></label>
            <input asp-for="CustomerId" class="form-control" />
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="AssignedAgentId" class="form-label"></label>
            <input asp-for="AssignedAgentId" class="form-control" />
            <span asp-validation-for="AssignedAgentId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CoverageType" class="form-label"></label>
            <input asp-for="CoverageType" class="form-control" />
            <span asp-validation-for="CoverageType" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="InceptionDate" class="form-label"></label>
            <input asp-for="InceptionDate" class="form-control" />
            <span asp-validation-for="InceptionDate" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ExpiryDate" class="form-label"></label>
            <input asp-for="ExpiryDate" class="form-control" />
            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Issue Policy</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
