@model PolicyDashboardViewModel
@{
    ViewData["Title"] = "Policy Admin";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Policy Dashboard</h2>
    <a class="btn btn-primary" asp-action="Create">Create Policy</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">Status</label>
        <select class="form-select" name="status" asp-for="StatusFilter">
            <option value="">All</option>
            <option value="Active">Active</option>
            <option value="Cancelled">Cancelled</option>
            <option value="Suspended">Suspended</option>
            <option value="Draft">Draft</option>
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary">Apply</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Policy Number</th>
                <th>Customer</th>
                <th>Product</th>
                <th>Premium</th>
                <th>Status</th>
                <th>Expiry</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Policies.Any())
            {
                <tr>
                    <td colspan="7" class="text-muted">No policies found.</td>
                </tr>
            }
            else
            {
                foreach (var policy in Model.Policies)
                {
                    <tr>
                        <td>@policy.PolicyNumber</td>
                        <td>@policy.CustomerId</td>
                        <td>@policy.ProductType</td>
                        <td>@policy.PremiumAmount.ToString("N2") @policy.CurrencyCode</td>
                        <td>@policy.Status</td>
                        <td>@policy.ExpiryDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Document" asp-route-policyNumber="@policy.PolicyNumber">Document</a>
                                <form asp-action="Endorse" method="post" class="d-flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="policyNumber" value="@policy.PolicyNumber" />
                                    <input type="text" name="note" placeholder="Endorse note" class="form-control form-control-sm" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Endorse</button>
                                </form>
                                <form asp-action="Cancel" method="post" class="d-flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="policyNumber" value="@policy.PolicyNumber" />
                                    <input type="text" name="reason" placeholder="Cancel reason" class="form-control form-control-sm" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
