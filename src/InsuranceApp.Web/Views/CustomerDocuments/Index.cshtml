@model CustomerDocumentsViewModel
@{
    ViewData["Title"] = "Customer Documents";
}

<h2>Customer Document Registry</h2>
<p class="text-muted">Office and admin teams can review intake, policy, and claim documents uploaded on behalf of customers.</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">Customer Number</label>
        <input name="customerNumber" value="@Model.CustomerNumberFilter" class="form-control" placeholder="CUS-..." />
    </div>
    <div class="col-md-3">
        <label class="form-label">Document Type</label>
        <input name="documentType" value="@Model.DocumentTypeFilter" class="form-control" placeholder="e.g. IntakeForm" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-outline-primary" type="submit">Filter</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Reference</th>
                <th>Type</th>
                <th>Customer</th>
                <th>Policy</th>
                <th>Claim</th>
                <th>File</th>
                <th>Provider</th>
                <th>Uploaded By</th>
                <th>Uploaded At (UTC)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Documents.Any())
            {
                <tr>
                    <td colspan="10" class="text-muted">No documents found.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Documents)
                {
                    <tr>
                        <td>@item.DocumentReference</td>
                        <td>@item.DocumentType</td>
                        <td>
                            <div>@item.CustomerNumber</div>
                            <small class="text-muted">@item.CustomerName</small>
                        </td>
                        <td>@item.PolicyNumber</td>
                        <td>@item.ClaimNumber</td>
                        <td>
                            <div>@item.FileName</div>
                            <small class="text-muted">@item.ContentType</small>
                        </td>
                        <td>@item.StorageProvider</td>
                        <td>@item.UploadedByUserId</td>
                        <td>@item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a href="@item.StorageUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">Open</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
