@model PayoutAdminViewModel
@{
    ViewData["Title"] = "Payout Admin";
}

<h2>Payout Admin</h2>
<p class="text-muted">Initiate payouts for approved claims and reconcile payout statuses.</p>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
            <option value="">All</option>
            <option value="Initiated">Initiated</option>
            <option value="Processing">Processing</option>
            <option value="Disbursed">Disbursed</option>
            <option value="Failed">Failed</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Claim Number</label>
        <input name="claimNumber" value="@Model.ClaimFilter" class="form-control" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-outline-primary" type="submit">Filter</button>
    </div>
</form>

<div class="card p-3 mb-3">
    <h5>Initiate Payout</h5>
    <form asp-action="Initiate" method="post" class="row g-2" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-md-3">
            <label asp-for="ClaimNumber" class="form-label"></label>
            <input asp-for="ClaimNumber" class="form-control" />
            <span asp-validation-for="ClaimNumber" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="DestinationChannel" class="form-label"></label>
            <input asp-for="DestinationChannel" class="form-control" />
            <span asp-validation-for="DestinationChannel" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="DestinationAccount" class="form-label"></label>
            <input asp-for="DestinationAccount" class="form-control" />
            <span asp-validation-for="DestinationAccount" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="ExternalReference" class="form-label"></label>
            <input asp-for="ExternalReference" class="form-control" />
            <span asp-validation-for="ExternalReference" class="text-danger"></span>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-primary" type="submit">Initiate</button>
        </div>
    </form>
</div>

<div class="d-flex gap-2 mb-3">
    <form asp-action="Reconcile" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-dark" type="submit">Run Reconciliation</button>
    </form>
</div>

<div class="card p-3 mb-3">
    <h5>Payout Webhook Simulation</h5>
    <form asp-action="ProcessWebhook" method="post" class="row g-2" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-md-3">
            <label asp-for="WebhookEventId" class="form-label">Event Id</label>
            <input asp-for="WebhookEventId" class="form-control" />
            <span asp-validation-for="WebhookEventId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="WebhookPayoutReference" class="form-label">Payout Reference</label>
            <input asp-for="WebhookPayoutReference" class="form-control" />
            <span asp-validation-for="WebhookPayoutReference" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="WebhookStatus" class="form-label">Status</label>
            <select asp-for="WebhookStatus" class="form-select">
                <option value="success">success</option>
                <option value="failed">failed</option>
                <option value="processing">processing</option>
            </select>
            <span asp-validation-for="WebhookStatus" class="text-danger"></span>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-outline-success" type="submit">Process</button>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Payout Ref</th>
                <th>Claim</th>
                <th>Status</th>
                <th>Amount</th>
                <th>Channel</th>
                <th>Account</th>
                <th>Provider Ref</th>
                <th>Disbursed</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Payouts.Any())
            {
                <tr>
                    <td colspan="8" class="text-muted">No payouts found.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Payouts)
                {
                    <tr>
                        <td>@item.PayoutReference</td>
                        <td>@item.ClaimNumber</td>
                        <td>@item.Status</td>
                        <td>@item.Amount.ToString("N2")</td>
                        <td>@item.DestinationChannel</td>
                        <td>@item.DestinationAccount</td>
                        <td>@item.ProviderReference</td>
                        <td>@(item.DisbursedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}