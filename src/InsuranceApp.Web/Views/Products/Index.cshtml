@model ProductCatalogViewModel
@using InsuranceApp.Domain.Enums
@{
    ViewData["Title"] = "Insurance Products";

    string BadgeClass(ProductType t) => t switch
    {
        ProductType.Motor => "bg-primary",
        ProductType.Life => "bg-success",
        ProductType.Health => "bg-info text-dark",
        ProductType.Funeral => "bg-secondary",
        ProductType.Education => "bg-warning text-dark",
        ProductType.Fire => "bg-danger",
        ProductType.Marine => "bg-primary",
        ProductType.Travel => "bg-info text-dark",
        ProductType.PersonalAccident => "bg-dark",
        ProductType.Home => "bg-success",
        ProductType.Agricultural => "bg-warning text-dark",
        ProductType.MicroInsurance => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string FriendlyType(ProductType t) => t switch
    {
        ProductType.PersonalAccident => "Personal Accident",
        ProductType.MicroInsurance => "Micro-Insurance",
        _ => t.ToString()
    };

    var productTypes = Model.Products.Select(p => p.ProductType).Distinct().OrderBy(x => x).ToList();
}

<h2>Insurance Products</h2>
<p class="text-muted">Browse our range of NIC-regulated insurance products designed for the Ghanaian market. Choose a product to learn more or get an instant quote.</p>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="alert alert-success d-flex justify-content-between align-items-center flex-wrap gap-2" role="alert">
        <span>You are signed in. Quotes and purchases will be linked to your account.</span>
        <a class="btn btn-sm btn-success" asp-controller="Customer" asp-action="Dashboard">Go to My Dashboard</a>
    </div>
}

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-auto">
        <label class="form-label">Filter by type</label>
        <select name="type" class="form-select" onchange="this.form.submit()">
            <option value="">All Products</option>
            @foreach (var pt in productTypes)
            {
                <option value="@pt" selected="@(Model.TypeFilter == pt.ToString())">@FriendlyType(pt)</option>
            }
        </select>
    </div>
</form>

<div class="row g-3">
    @if (!Model.Products.Any())
    {
        <div class="col-12">
            <div class="alert alert-warning">No active products are available right now. Please check back later.</div>
        </div>
    }
    else
    {
        foreach (var product in Model.Products)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@product.Name</h5>
                            <span class="badge @BadgeClass(product.ProductType)">@FriendlyType(product.ProductType)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(product.NicClassCode))
                        {
                            <small class="text-muted mb-1">@product.NicClassCode</small>
                        }
                        <p class="card-text small">@product.Description</p>
                        <ul class="list-unstyled small mb-2">
                            <li><strong>Min. Premium:</strong> @product.MinPremium.ToString("N2") @product.CurrencyCode</li>
                            @if (product.MaxCoverageAmount > 0)
                            {
                                <li><strong>Max. Cover:</strong> @product.MaxCoverageAmount.ToString("N0") @product.CurrencyCode</li>
                            }
                            @if (product.MinEntryAgeYears > 0 || product.MaxEntryAgeYears < 99)
                            {
                                <li><strong>Entry Age:</strong> @product.MinEntryAgeYears&ndash;@product.MaxEntryAgeYears years</li>
                            }
                            @if (product.WaitingPeriodDays > 0)
                            {
                                <li><strong>Waiting Period:</strong> @product.WaitingPeriodDays days</li>
                            }
                            @if (!string.IsNullOrWhiteSpace(product.PolicyTermOptions))
                            {
                                <li><strong>Terms:</strong> @product.PolicyTermOptions</li>
                            }
                        </ul>
                        <div class="mt-auto d-flex gap-2">
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-code="@product.ProductCode">View Details</a>
                            <a class="btn btn-primary btn-sm" asp-controller="Quote" asp-action="Start" asp-route-code="@product.ProductCode">Get Quote</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
