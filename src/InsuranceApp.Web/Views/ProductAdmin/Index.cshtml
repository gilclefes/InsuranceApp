@model IReadOnlyCollection<InsuranceApp.Domain.Entities.ProductDefinition>
@{
    ViewData["Title"] = "Product Admin";
}

<h2>Product Configuration</h2>
<p>Manage risk rules, riders, and product details for configured insurance products.</p>

<div class="table-responsive">
<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Type</th>
            <th>NIC Class</th>
            <th>Min Premium</th>
            <th>Max Cover</th>
            <th>Age Range</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.ProductCode</td>
            <td>@p.Name</td>
            <td>@p.ProductType</td>
            <td>@p.NicClassCode</td>
            <td>@p.MinPremium.ToString("N2") @p.CurrencyCode</td>
            <td>@(p.MaxCoverageAmount > 0 ? $"{p.MaxCoverageAmount:N0} {p.CurrencyCode}" : "-")</td>
            <td>@p.MinEntryAgeYears&ndash;@p.MaxEntryAgeYears</td>
            <td>@(p.IsActive ? "Active" : "Inactive")</td>
            <td>
                <a class="btn btn-sm btn-primary" asp-controller="ProductAdmin" asp-action="Configure" asp-route-id="@p.Id">Configure</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
