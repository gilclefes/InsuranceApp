@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - InsuranceApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --brand-primary: #0f766e;
            --brand-secondary: #115e59;
            --brand-highlight: #14b8a6;
            --surface: #f5f7fb;
            --panel: #ffffff;
            --text-main: #0f172a;
            --text-muted: #475569;
            --border-soft: #d8e0eb;
            --danger-soft-bg: #fff1f2;
            --danger-soft-border: #fecdd3;
            --danger-soft-text: #be123c;
            --focus-ring: rgba(20, 184, 166, 0.2);
            --shadow-soft: 0 24px 48px rgba(15, 23, 42, 0.12);
        }

        html,
        body {
            height: 100%;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", "Aptos", "Helvetica Neue", sans-serif;
            background: radial-gradient(circle at 15% 20%, #e8fffa 0%, transparent 45%),
                        radial-gradient(circle at 85% 80%, #e6f2ff 0%, transparent 45%),
                        var(--surface);
            color: var(--text-main);
        }

        .auth-shell {
            min-height: 100vh;
        }

        .brand-panel {
            display: none;
            padding: 4rem;
            color: #e6fffb;
            background:
                linear-gradient(140deg, rgba(255, 255, 255, 0.09) 15%, transparent 15% 55%, rgba(255, 255, 255, 0.08) 55% 85%, transparent 85%),
                linear-gradient(135deg, var(--brand-secondary), var(--brand-primary) 58%, #0b3e3a 100%);
        }

        .brand-kicker {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.35rem 0.7rem;
            border-radius: 9999px;
            background-color: rgba(255, 255, 255, 0.16);
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.01em;
        }

        .brand-title {
            margin-top: 1.5rem;
            margin-bottom: 1rem;
            font-size: clamp(1.9rem, 2.8vw, 3rem);
            line-height: 1.15;
            letter-spacing: -0.02em;
            font-weight: 700;
        }

        .brand-text {
            max-width: 34rem;
            color: rgba(230, 255, 251, 0.92);
            font-size: 1.05rem;
            line-height: 1.7;
        }

        .auth-column {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 1.4rem;
        }

        .auth-card {
            width: 100%;
            max-width: 30rem;
            background: var(--panel);
            border-radius: 1.15rem;
            border: 1px solid rgba(15, 118, 110, 0.08);
            box-shadow: var(--shadow-soft);
            padding: 1.5rem;
            animation: reveal 420ms ease-out;
        }

        .app-mini {
            text-align: center;
            margin-bottom: 1.25rem;
        }

        .app-mini .dot {
            width: 0.65rem;
            height: 0.65rem;
            display: inline-block;
            background: linear-gradient(135deg, var(--brand-highlight), var(--brand-primary));
            border-radius: 50%;
            margin-right: 0.5rem;
            transform: translateY(-1px);
        }

        .app-mini .name {
            font-weight: 700;
            letter-spacing: -0.01em;
            color: var(--text-main);
        }

        .form-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.35rem;
            letter-spacing: -0.01em;
        }

        .form-subtitle {
            color: var(--text-muted);
            margin-bottom: 1.2rem;
        }

        .form-label {
            font-weight: 600;
            margin-bottom: 0.45rem;
            color: #1e293b;
        }

        .form-control {
            min-height: 3rem;
            border-radius: 0.8rem;
            border: 1px solid var(--border-soft);
            padding: 0.68rem 0.9rem;
            font-size: 1rem;
            transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
        }

        .form-control::placeholder {
            color: #94a3b8;
        }

        .form-control:focus {
            border-color: var(--brand-highlight);
            box-shadow: 0 0 0 0.25rem var(--focus-ring);
            transform: translateY(-1px);
        }

        .form-check-input {
            border-color: #9fb3c8;
            width: 1.05rem;
            height: 1.05rem;
            margin-top: 0.2rem;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 0.2rem var(--focus-ring);
            border-color: var(--brand-highlight);
        }

        .form-check-input:checked {
            background-color: var(--brand-primary);
            border-color: var(--brand-primary);
        }

        .remember-label {
            color: #334155;
            font-weight: 500;
            user-select: none;
        }

        .forgot-link {
            color: var(--brand-secondary);
            font-weight: 600;
            text-decoration: none;
            transition: color 180ms ease;
        }

        .forgot-link:hover,
        .forgot-link:focus-visible {
            color: #0b4f4b;
            text-decoration: underline;
        }

        .btn-signin {
            min-height: 3rem;
            border: 0;
            border-radius: 0.8rem;
            background: linear-gradient(135deg, var(--brand-primary), #0d9488);
            color: #ffffff;
            font-weight: 700;
            letter-spacing: 0.01em;
            transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
        }

        .btn-signin:hover {
            filter: brightness(1.03);
            box-shadow: 0 14px 20px rgba(15, 118, 110, 0.25);
            transform: translateY(-1px);
        }

        .btn-signin:active {
            transform: translateY(0);
            box-shadow: 0 8px 14px rgba(15, 118, 110, 0.2);
        }

        .validation-summary.validation-summary-valid {
            display: none;
        }

        .validation-summary.validation-summary-errors {
            margin-bottom: 1rem;
            border: 1px solid var(--danger-soft-border);
            background-color: var(--danger-soft-bg);
            color: var(--danger-soft-text);
            border-radius: 0.8rem;
            padding: 0.75rem 0.95rem;
            font-size: 0.95rem;
        }

        .validation-summary.validation-summary-errors ul {
            margin: 0;
            padding-left: 1.15rem;
        }

        .field-validation-error {
            display: inline-block;
            margin-top: 0.35rem;
            color: var(--danger-soft-text);
            font-size: 0.88rem;
            font-weight: 500;
        }

        @@keyframes reveal {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (min-width: 768px) {
            .auth-shell {
                display: flex;
            }

            .brand-panel {
                width: 56%;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .auth-column {
                width: 44%;
                padding: 2rem;
            }

            .auth-card {
                padding: 2rem;
            }

            .app-mini {
                display: none;
            }
        }
    </style>
</head>
<body>
    <main class="auth-shell" role="main">
        <section class="brand-panel" aria-label="InsuranceApp platform overview">
            <div>
                <span class="brand-kicker">Insurance Platform</span>
                <h1 class="brand-title">Protect every customer journey with speed and confidence.</h1>
                <p class="brand-text mb-0">
                    InsuranceApp unifies policy operations, claims workflows, customer onboarding, and compliance into one secure platform.
                    Teams process requests faster, collaborate transparently, and deliver a trusted digital experience at scale.
                </p>
            </div>
        </section>

        <section class="auth-column" aria-label="Sign in panel">
            <div class="auth-card" role="region" aria-labelledby="signin-heading">
                <div class="app-mini" aria-label="Application name">
                    <span class="dot" aria-hidden="true"></span>
                    <span class="name">InsuranceApp</span>
                </div>

                <h2 id="signin-heading" class="form-title">Welcome back</h2>
                <p class="form-subtitle">Sign in to continue to your operations workspace.</p>

                <form asp-action="Login" asp-route-returnurl="@Model.ReturnUrl" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert" aria-live="polite"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="username"
                               inputmode="email"
                               placeholder="name@company.com"
                               aria-describedby="email-validation" />
                        <span id="email-validation" asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password"
                               class="form-control"
                               autocomplete="current-password"
                               placeholder="Enter your password"
                               aria-describedby="password-validation" />
                        <span id="password-validation" asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                        <div class="form-check m-0">
                            <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe" value="true" />
                            <label class="form-check-label remember-label" for="rememberMe">Remember me</label>
                        </div>
                        <a class="forgot-link" asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-signin w-100">Sign in securely</button>
                </form>
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
