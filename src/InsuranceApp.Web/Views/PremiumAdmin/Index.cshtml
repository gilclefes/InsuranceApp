@model PremiumAdminViewModel
@{
    ViewData["Title"] = "Premium Admin";
}

<h2>Premium Collections</h2>
<p class="text-muted">Capture mandates, schedule collections, and run due/retry cycles for policies.</p>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <label class="form-label">Policy Number</label>
        <input name="policyNumber" value="@Model.PolicyNumber" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">From</label>
        <input name="fromUtc" type="date" value="@Model.ReconciliationFromUtc.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">To</label>
        <input name="toUtc" type="date" value="@Model.ReconciliationToUtc.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary">Load</button>
    </div>
</form>

@if (Model.Reconciliation is not null)
{
    <div class="card p-3 mb-3">
        <h5>Reconciliation Summary</h5>
        <div class="row g-2">
            <div class="col-md-2"><strong>Total:</strong> @Model.Reconciliation.TotalTransactions</div>
            <div class="col-md-2"><strong>Success:</strong> @Model.Reconciliation.SuccessCount</div>
            <div class="col-md-2"><strong>Failed:</strong> @Model.Reconciliation.FailedCount</div>
            <div class="col-md-2"><strong>Pending:</strong> @Model.Reconciliation.PendingCount</div>
            <div class="col-md-2"><strong>Total Amt:</strong> @Model.Reconciliation.TotalAmount.ToString("N2")</div>
            <div class="col-md-2"><strong>Failed Amt:</strong> @Model.Reconciliation.FailedAmount.ToString("N2")</div>
        </div>
    </div>
}

<form asp-action="CreateMandate" method="post" class="card p-3 mb-3" novalidate>
    @Html.AntiForgeryToken()
    <h5>Capture Mandate</h5>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-2">
        <div class="col-md-3">
            <label asp-for="PolicyNumber" class="form-label"></label>
            <input asp-for="PolicyNumber" class="form-control" />
            <span asp-validation-for="PolicyNumber" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Provider" class="form-label"></label>
            <input asp-for="Provider" class="form-control" />
            <span asp-validation-for="Provider" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="PaymentChannel" class="form-label"></label>
            <input asp-for="PaymentChannel" class="form-control" />
            <span asp-validation-for="PaymentChannel" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="DueDateUtc" class="form-label">First Due Date</label>
            <input asp-for="DueDateUtc" class="form-control" />
            <span asp-validation-for="DueDateUtc" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-2">
        <button type="submit" class="btn btn-primary">Create Mandate</button>
    </div>
</form>

<form asp-action="Schedule" method="post" class="card p-3 mb-3" novalidate>
    @Html.AntiForgeryToken()
    <h5>Schedule Collection</h5>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-2">
        <div class="col-md-3">
            <label asp-for="PolicyNumber" class="form-label"></label>
            <input asp-for="PolicyNumber" class="form-control" />
            <span asp-validation-for="PolicyNumber" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Provider" class="form-label"></label>
            <input asp-for="Provider" class="form-control" />
            <span asp-validation-for="Provider" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="PaymentChannel" class="form-label"></label>
            <input asp-for="PaymentChannel" class="form-control" />
            <span asp-validation-for="PaymentChannel" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="DueDateUtc" class="form-label"></label>
            <input asp-for="DueDateUtc" class="form-control" />
            <span asp-validation-for="DueDateUtc" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-2">
        <button type="submit" class="btn btn-outline-primary">Schedule</button>
    </div>
</form>

<div class="d-flex gap-2 mb-3">
    <form asp-action="RunDue" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-dark">Run Due Collections</button>
    </form>
    <form asp-action="RetryFailed" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-dark">Retry Failed</button>
    </form>
</div>

<form asp-action="ProcessWebhook" method="post" class="card p-3 mb-3" novalidate>
    @Html.AntiForgeryToken()
    <h5>Webhook Processing (Idempotent)</h5>
    <p class="text-muted mb-2">Use this form to simulate provider webhook callbacks and verify duplicate-event handling.</p>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-2">
        <div class="col-md-3">
            <label asp-for="WebhookEventId" class="form-label">Event ID</label>
            <input asp-for="WebhookEventId" class="form-control" placeholder="EVT-..." />
            <span asp-validation-for="WebhookEventId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="WebhookTransactionReference" class="form-label">Transaction Reference</label>
            <input asp-for="WebhookTransactionReference" class="form-control" placeholder="COL-POL-..." />
            <span asp-validation-for="WebhookTransactionReference" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="WebhookStatus" class="form-label">Status</label>
            <select asp-for="WebhookStatus" class="form-select">
                <option value="success">success</option>
                <option value="failed">failed</option>
                <option value="processing">processing</option>
            </select>
            <span asp-validation-for="WebhookStatus" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Provider" class="form-label">Provider</label>
            <input asp-for="Provider" class="form-control" />
            <span asp-validation-for="Provider" class="text-danger"></span>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-success w-100">Process Webhook</button>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Reference</th>
                <th>Status</th>
                <th>Amount</th>
                <th>Provider</th>
                <th>Channel</th>
                <th>Due Date</th>
                <th>Processed</th>
                <th>Retry</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="8" class="text-muted">Load a policy number to view premium collection history.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.TransactionReference</td>
                        <td>@item.Status</td>
                        <td>@item.Amount.ToString("N2") @item.CurrencyCode</td>
                        <td>@item.Provider</td>
                        <td>@item.PaymentChannel</td>
                        <td>@item.DueDateUtc.ToString("yyyy-MM-dd")</td>
                        <td>@(item.ProcessedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td>@item.RetryCount</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
