@model MyPoliciesViewModel
@{
    ViewData["Title"] = "My Policies";
}

<h2>My policies</h2>

@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

<table class="table table-striped">
    <thead>
        <tr>
            <th>Policy</th>
            <th>Product</th>
            <th>Coverage</th>
            <th>Premium</th>
            <th>Status</th>
            <th>Expiry</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Policies.Any())
        {
            <tr><td colspan="7" class="text-muted">No policies yet. <a asp-controller="Products" asp-action="Index">Buy your first policy</a>.</td></tr>
        }
        else
        {
            foreach (var p in Model.Policies)
            {
                <tr>
                    <td>@p.PolicyNumber</td>
                    <td>@p.ProductType</td>
                    <td>@p.CoverageType</td>
                    <td>@p.PremiumAmount.ToString("N2") @p.CurrencyCode</td>
                    <td>@p.Status</td>
                    <td>@p.ExpiryDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="PolicyDocument" asp-route-policyNumber="@p.PolicyNumber">Document</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
